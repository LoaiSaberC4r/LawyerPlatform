# Copy this file to .env and replace every placeholder.
# Never commit the real .env file.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://+:8081;http://+:8080

# SQL Server
ConnectionStrings__Database=Server=localhost,1433;Database=LawyerPlatformDb;User Id=sa;Password=<SQL_SERVER_PASSWORD>;Encrypt=True;TrustServerCertificate=True

# JWT
Authentication__Jwt__Issuer=LawyerPlatform.Api
Authentication__Jwt__Audience=LawyerPlatform.Clients
Authentication__Jwt__Key=<AT_LEAST_64_RANDOM_CHARACTERS>
Authentication__Jwt__AccessTokenExpirationMinutes=60

# Initial SuperAdmin seed
InitialSuperAdmin__Enabled=true
InitialSuperAdmin__Id=11111111-1111-1111-1111-111111111111
InitialSuperAdmin__UserName=<SUPERADMIN_USERNAME>
InitialSuperAdmin__Email=<SUPERADMIN_EMAIL>
InitialSuperAdmin__PhoneNumber=<SUPERADMIN_PHONE>
InitialSuperAdmin__Password=<STRONG_TEMPORARY_PASSWORD>

# Password lifecycle
PasswordLifecycle__ExpiryDays=90

# Localization
Localization__DefaultCulture=ar
Localization__SupportedCultures__0=ar
Localization__SupportedCultures__1=en
