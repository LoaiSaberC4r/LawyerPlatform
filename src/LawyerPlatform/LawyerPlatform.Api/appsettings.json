{
  "ConnectionStrings": {
    "Database": "Server=.\\SQLEXPRESS;Database=LawyerPlatform;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Authentication": {
    "Jwt": {
      "Issuer": "LawyerPlatform.Api",
      "Audience": "LawyerPlatform.Clients",
      "Key": "008407CDE3FCF2BA9CAC15358408A823F1759B98FDE39546E1BE389ED7E710ABBC00B2379B4EB01E7B210AEF1D87516B1AFAA36907F98956786272EE59D8CA14",
      "AccessTokenExpirationMinutes": 60
    }
  },

  "CurrentUserClaims": {
    "UserIdClaimType": "sub",
    "UserNameClaimType": "preferred_username",
    "EmailClaimType": "email",
    "RoleClaimType": "role",
    "PermissionClaimType": "permission",
    "MaximumClaimValueLength": 2048,
    "MaximumRoles": 100,
    "MaximumPermissions": 500
  },

  "InitialSuperAdmin": {
    "Enabled": true,
    "Id": "11111111-1111-1111-1111-111111111111",
    "UserName": "superadmin",
    "Email": "admin@lawyerplatform.local",
    "PhoneNumber": "01000000000",
    "Password": "Aa1!2CCAF64A2EDDDC3D7D5F7FD562509EDBCAC80FD529704CC4"
  },

  "PasswordLifecycle": {
    "ExpiryDays": 90
  },

  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": true
  },

  "MediaStorage": {
    "RootPath": "App_Data/Media",
    "MaxFileSizeBytes": 10485760,
    "RequireMalwareScanner": false,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".pdf"
    ],
    "AllowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "application/pdf"
    ]
  },

  "LawyerDocuments": {
    "RequiredDocumentTypes": [
      "IdentityVerification",
      "ProfessionalMembership"
    ],
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".pdf"
    ],
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "application/pdf"
    ],
    "MaximumFileSizeBytes": 10485760
  },

  "Localization": {
    "SupportedCultures": [
      "ar",
      "en"
    ],
    "DefaultCulture": "ar",
    "AllowQueryStringLang": true
  },

  "Cors": {
    "AllowAnyOrigin": false,
    "AllowCredentials": false,
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:50005",
      "http://localhost:4201"

    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Diagnostics": {
      "Enabled": false
    },
    "Requests": {
      "IncludeClientIp": false,
      "IncludeUserAgent": true,
      "IncludeQueryString": false,
      "IncludeRequestHeaders": false,
      "IncludeResponseHeaders": false,
      "AllowedRequestHeaders": [],
      "AllowedResponseHeaders": [],
      "ExcludedPaths": [
        "/health"
      ]
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/LawyerPlatform-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 14
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },

  "AllowedHosts": "*"
}
