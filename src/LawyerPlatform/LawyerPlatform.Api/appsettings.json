{
  "ConnectionStrings": {
    "Database": "Server=.\\SQLEXPRESS;Database=LawyerPlatform;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "LawyerPlatform.Api",
      "Audience": "LawyerPlatform.Clients",
      "Key": "<AT_LEAST_64_RANDOM_CHARACTERS>",
      "AccessTokenExpirationMinutes": 60
    }
  },
  "CurrentUserClaims": {
    "UserIdClaimType": "sub",
    "UserNameClaimType": "preferred_username",
    "EmailClaimType": "email",
    "RoleClaimType": "role",
    "PermissionClaimType": "permission",
    "MaximumClaimValueLength": 2048,
    "MaximumRoles": 100,
    "MaximumPermissions": 500
  },
  "InitialSuperAdmin": {
    "Enabled": false
  },
  "PasswordLifecycle": {
    "ExpiryDays": 90
  },
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": true
  },
  "MediaStorage": {
    "RootPath": "App_Data/Media",
    "MaxFileSizeBytes": 10485760,
    "RequireMalwareScanner": false,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".pdf" ],
    "AllowedMimeTypes": [ "image/jpeg", "image/png", "image/gif", "application/pdf" ]
  },
  "LawyerDocuments": {
    "RequiredDocumentTypes": [],
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".pdf" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "application/pdf" ],
    "MaximumFileSizeBytes": 10485760
  },
  "Localization": {
    "SupportedCultures": [ "en", "ar" ],
    "DefaultCulture": "en",
    "AllowQueryStringLang": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Diagnostics": {
      "Enabled": false
    },
    "Requests": {
      "IncludeClientIp": false,
      "IncludeUserAgent": true,
      "IncludeQueryString": false,
      "IncludeRequestHeaders": false,
      "IncludeResponseHeaders": false,
      "AllowedRequestHeaders": [],
      "AllowedResponseHeaders": [],
      "ExcludedPaths": [ "/health" ]
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Async" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/LawyerPlatform-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 14
              }
            }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
